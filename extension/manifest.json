{
  "manifest_version": 3,
  "name": "Promptomizer",
  "short_name": "Promptomizer",
  "version": "0.1.0",
  "description": "Suchen, kopieren, einfügen – deine eigenen Promptomizer-Prompts und Bausteine in jedem KI-Tool.",
  "key": "",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Promptomizer – Prompt kopieren",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Promptomizer-Popup öffnen"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://nrrsroaubbpmjyexhuhi.supabase.co/*"
  ]
}
