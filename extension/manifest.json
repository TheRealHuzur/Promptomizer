{
  "manifest_version": 3,
  "name": "Promptomizer",
  "short_name": "Promptomizer",
  "version": "1.1.0",
  "description": "Deine Prompt-Bibliothek als Seitenleiste: Prompts und Bausteine suchen, kopieren, bearbeiten und anlegen, in jedem KI-Tool.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Promptomizer-Seitenleiste öffnen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Promptomizer-Seitenleiste öffnen"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://nrrsroaubbpmjyexhuhi.supabase.co/*"
  ]
}
